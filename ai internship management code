// 6. WORK SUBMISSION & AI ANALYSIS ENGINE
// ----------------------------------------------------------------------
function WorkSubmissionView({ tasks, setTasks, setEmails, addToast, geminiApiKey, setActiveTab, setSelectedTaskForReview }) {
  const [selectedTaskId, setSelectedTaskId] = useState(tasks[0]?.id || '');
  const [summary, setSummary] = useState('');
  const [repoUrl, setRepoUrl] = useState('');
  const [codeSnippet, setCodeSnippet] = useState('');
  const [challenges, setChallenges] = useState('');
  const [progress, setProgress] = useState(90);
  const [analyzing, setAnalyzing] = useState(false);

  const activeTask = tasks.find(t => t.id === selectedTaskId) || tasks[0];

  const handleSubmitAndAnalyze = async (e) => {
    e.preventDefault();
    if (!summary || !repoUrl) {
      addToast('Validation Error', 'Summary and Repository URL are required', 'error');
      return;
    }

    setAnalyzing(true);

    try {
      // Perform Gemini AI Submission Analysis
      const prompt = `
Act as an expert Technical Code Reviewer and AI Auditor.
Compare the intern's submission against original task requirements.

ORIGINAL TASK REQUIREMENTS:
Title: ${activeTask.title}
Objectives: ${activeTask.objectives}
Expected Output: ${activeTask.expectedOutput}

INTERN SUBMISSION DETAILS:
Summary: ${summary}
Repository: ${repoUrl}
Code Snippet: ${codeSnippet}
Challenges Faced: ${challenges}
Self Reported Progress: ${progress}%

Output JSON schema format:
{
  "score": number (0-100),
  "statusSuggestion": "Needs Improvement" | "Ready for Mentor Review" | "Potentially Complete",
  "completedRequirements": string[],
  "missingRequirements": string[],
  "errorsIdentified": string[],
  "recommendedImprovements": string[],
  "nextActions": string
}
`;

      const apiKey = geminiApiKey || "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { responseMimeType: "application/json" }
        })
      });

      let aiResult;
      try {
        const data = await response.json();
        const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
        aiResult = JSON.parse(jsonText);
      } catch {
        // Fallback structural report if API key not provided or JSON parse fails
        aiResult = {
          score: Math.min(progress, 88),
          statusSuggestion: progress >= 85 ? 'Ready for Mentor Review' : 'Needs Improvement',
          completedRequirements: ['Core functionality implementation', 'Repository structure'],
          missingRequirements: ['Automated test suite execution evidence', 'Edge case error handling'],
          errorsIdentified: ['Potential unhandled exception during network timeout.'],
          recommendedImprovements: ['Add unit test coverage', 'Refactor code structure for readability'],
          nextActions: 'Forward to Human Mentor for final verification.'
        };
      }

      // Update Task with submission & AI Report
      const updatedSubmission = {
        submittedAt: new Date().toISOString().replace('T', ' ').substring(0, 16),
        summary,
        repoUrl,
        codeSnippet,
        challenges,
        progressPercentage: progress
      };

      setTasks(prev => prev.map(t => t.id === activeTask.id ? {
        ...t,
        status: 'Submitted',
        submission: updatedSubmission,
        aiAnalysis: aiResult
      } : t));

      // Trigger Mentor Notification Email
      setEmails(prev => [{
        id: `EML-${Date.now()}`,
        taskId: activeTask.id,
        recipientEmail: 'sarah.c@techcorp.io',
        recipientName: activeTask.mentorName,
        type: 'Intern Submission Alert',
        subject: `Work Submitted for Review: ${activeTask.title}`,
        scheduledTime: new Date().toISOString().replace('T', ' ').substring(0, 16),
        sentAt: new Date().toISOString().replace('T', ' ').substring(0, 16),
        status: 'Sent',
        retryCount: 0,
        body: `Hi ${activeTask.mentorName},\n\n${activeTask.internName} has submitted work for task "${activeTask.title}". AI analysis has completed with score ${aiResult.score}%. Please open your Mentor Review Hub.`
      }, ...prev]);

      addToast('Submission Complete', 'AI analysis report generated. Task queued for Mentor Review.', 'success');
      setSelectedTaskForReview(activeTask);
      setActiveTab('mentor-hub');
    } catch (err) {
      console.error(err);
      addToast('Submission Error', 'Failed to complete AI submission analysis.', 'error');
    } finally {
      setAnalyzing(false);
    }
  };

  return (
    <div className="max-w-3xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
      <div className="border-b pb-4 dark:border-slate-700">
        <h2 className="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
          <Upload className="w-5 h-5 text-indigo-500" /> Submit Task Implementation
        </h2>
        <p className="text-xs text-slate-500 mt-1">Submit your completed work, code repository, and self-explanation for automated AI analysis and mentor review.</p>
      </div>

      <form onSubmit={handleSubmitAndAnalyze} className="space-y-4 text-xs">
        <div>
          <label className="block font-semibold mb-1 text-slate-700 dark:text-slate-300">Select Task to Submit</label>
          <select
            value={selectedTaskId}
            onChange={e => setSelectedTaskId(e.target.value)}
            className="w-full p-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl outline-none"
          >
            {tasks.map(t => (
              <option key={t.id} value={t.id}>{t.title} ({t.status})</option>
            ))}
          </select>
        </div>

        <div>
          <label className="block font-semibold mb-1 text-slate-700 dark:text-slate-300">Implementation Summary & Explanation</label>
          <textarea
            rows={3}
            required
            placeholder="Explain what you built, how you solved the problem, and key architecture decisions..."
            value={summary}
            onChange={e => setSummary(e.target.value)}
            className="w-full p-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl outline-none"
          />
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label className="block font-semibold mb-1 text-slate-700 dark:text-slate-300">Repository or Document Link</label>
            <input
              type="url"
              required
              placeholder="https://github.com/org/repo-name"
              value={repoUrl}
              onChange={e => setRepoUrl(e.target.value)}
