            <UserCheck className="w-5 h-5 text-indigo-500" /> Human Mentor & AI Collaboration Hub
          </h2>
          <p className="text-xs text-slate-500">Side-by-side verification: Original requirements vs AI Analysis vs Intern implementation.</p>
        </div>

        <div className="flex items-center gap-2 w-full sm:w-auto">
          <span className="text-xs font-semibold text-slate-400 whitespace-nowrap">Select Task:</span>
          <select
            value={activeTask?.id}
            onChange={e => setSelectedTask(tasks.find(t => t.id === e.target.value))}
            className="w-full sm:w-64 p-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none"
          >
            {tasks.map(t => (
              <option key={t.id} value={t.id}>{t.internName} - {t.title}</option>
            ))}
          </select>
        </div>
      </div>

      {/* Side by Side Dual View */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {/* Left Column: Original Task & Submission */}
        <div className="space-y-4">
          {/* Original Mentor Requirements */}
          <div className="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-3">
            <div className="flex items-center justify-between border-b pb-2 dark:border-slate-700">
              <h3 className="font-bold text-xs uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                <FileText className="w-4 h-4 text-indigo-500" /> 1. Original Task Requirements (v{activeTask.version})
              </h3>
              <StatusBadge status={activeTask.status} />
            </div>

            <div className="text-xs space-y-2">
              <h4 className="font-bold text-sm text-slate-800 dark:text-slate-100">{activeTask.title}</h4>
              <p className="text-slate-600 dark:text-slate-300">{activeTask.description}</p>
              
              <div className="pt-2">
                <span className="font-semibold text-slate-700 dark:text-slate-300">Expected Deliverables:</span>
