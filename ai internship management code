        <p className="text-xs text-slate-500 mt-1">Configure Gemini API Key and SMTP mock credentials.</p>
      </div>

      <div className="space-y-4 text-xs">
        <div>
          <label className="block font-semibold mb-1 text-slate-700 dark:text-slate-300">Google Gemini API Key</label>
          <div className="flex gap-2">
            <input
              type="password"
              placeholder="AIzaSy..."
              value={inputKey}
              onChange={e => setInputKey(e.target.value)}
              className="flex-1 p-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl outline-none"
            />
            <button
              onClick={handleSaveKey}
              className="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl transition-all"
            >
              Save Key
            </button>
          </div>
          <p className="text-[10px] text-slate-400 mt-1">If left blank, the app will execute API queries with default runtime credentials.</p>
