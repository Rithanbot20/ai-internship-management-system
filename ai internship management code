function ExcelImportExportModule({ interns, setInterns, addToast }) {
  const [validationReport, setValidationReport] = useState(null);

  // Simulated File Import Parser with Dup & Email Validation
  const handleSimulatedImport = (e) => {
    const file = e.target.files[0];
    if (!file) return;

    // Simulate CSV parsing & schema verification
    setTimeout(() => {
      const mockParsedData = [
        { id: 'INT-1001', fullName: 'Alex Johnson', email: 'alex@interns.techcorp.io', department: 'AI & Machine Learning', skills: 'Python, LLMs', mentorName: 'Sarah Connor' }, // Dup ID!
        { id: 'INT-9902', fullName: 'Invalid User', email: '', department: 'Frontend', skills: 'HTML, CSS', mentorName: 'Marcus Vance' }, // Missing Email!
        { id: 'INT-9903', fullName: 'Samantha Reed', email: 'samantha.r@interns.techcorp.io', department: 'DevOps & CyberSec', skills: 'AWS, Terraform', mentorName: 'David Chen' } // Valid
      ];

      const errors = [];
      const validRecords = [];
      const existingIds = new Set(interns.map(i => i.id));

      mockParsedData.forEach((row, idx) => {
        if (!row.email) {
          errors.push(`Row ${idx + 1}: Missing mandatory email for '${row.fullName}'.`);
        } else if (existingIds.has(row.id)) {
          errors.push(`Row ${idx + 1}: Duplicate Intern ID '${row.id}' detected.`);
        } else {
          validRecords.push({
            ...row,
            joiningDate: new Date().toISOString().split('T')[0],
            duration: '6 Months',
            status: 'Active',
            tasksAssigned: 0,
            tasksCompleted: 0,
            progressScore: 100
          });
        }
      });

      setValidationReport({ errors, validRecordsCount: validRecords.length });

      if (validRecords.length > 0) {
        setInterns(prev => [...validRecords, ...prev]);
        addToast('Import Completed', `Successfully imported ${validRecords.length} new intern records.`, 'success');
      } else {
        addToast('Import Failed', `No valid intern records could be imported.`, 'error');
      }
    }, 600);
  };

  const handleExportCSV = () => {
    const headers = ['Intern ID', 'Full Name', 'Email', 'Department', 'Skills', 'Mentor Name', 'Status', 'Progress Score'];
    const rows = interns.map(i => [i.id, i.fullName, i.email, i.department, `"${i.skills}"`, i.mentorName, i.status, `${i.progressScore}%`]);
    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `Intern_Management_Report_${new Date().toISOString().split('T')[0]}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    addToast('Report Exported', 'CSV/Excel file download initiated.', 'success');
  };

  return (
    <div className="space-y-6">
      <div className="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
        <div>
          <h2 className="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
            <FileSpreadsheet className="w-5 h-5 text-indigo-500" /> Excel & CSV Data Exchange
          </h2>
          <p className="text-xs text-slate-500 mt-1">
            Import bulk intern lists (.xlsx / .csv) or export full performance reports. Automatic validation checks duplicate IDs, missing emails, and formatting errors.
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          {/* Upload Area */}
          <div className="border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-6 flex flex-col items-center justify-center text-center hover:border-indigo-500 transition-colors bg-slate-50/50 dark:bg-slate-900/40">
            <Upload className="w-10 h-10 text-indigo-500 mb-3" />
            <h3 className="font-bold text-sm">Upload Intern Data File</h3>
            <p className="text-xs text-slate-400 mt-1 mb-4">Supports .XLSX or .CSV format files up to 10MB</p>
            
            <label className="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold cursor-pointer transition-all shadow-md">
              Browse File & Validate
              <input type="file" accept=".csv, .xlsx" className="hidden" onChange={handleSimulatedImport} />
            </label>
          </div>

          {/* Export Area */}
          <div className="border border-slate-200 dark:border-slate-700 rounded-2xl p-6 flex flex-col justify-between bg-slate-50/50 dark:bg-slate-900/40">
            <div>
              <Download className="w-10 h-10 text-emerald-500 mb-3" />
