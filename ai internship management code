// 7. DUAL-VIEW MENTOR REVIEW & APPROVAL COLLABORATION HUB
// ----------------------------------------------------------------------
function MentorReviewCollaborationHub({ tasks, setTasks, setEmails, addToast, selectedTask, setSelectedTask }) {
  const activeTask = selectedTask || tasks[0];
  const [mentorComment, setMentorComment] = useState('');
  const [rescheduleDate, setRescheduleDate] = useState('');

  const handleMentorDecision = (actionType) => {
    let newStatus = activeTask.status;
    let toastMessage = '';

    if (actionType === 'APPROVE') {
      newStatus = 'Approved';
      toastMessage = `Task "${activeTask.title}" approved!`;
    } else if (actionType === 'REQUEST_CHANGES') {
      newStatus = 'Needs Improvement';
      toastMessage = `Changes requested for "${activeTask.title}".`;
    } else if (actionType === 'BLOCK') {
      newStatus = 'Blocked';
      toastMessage = `Task marked as blocked.`;
    }

    // Update Task Status & Save Feedback
    setTasks(prev => prev.map(t => t.id === activeTask.id ? {
      ...t,
      status: newStatus,
      version: actionType === 'REQUEST_CHANGES' ? t.version + 1 : t.version,
      firstReviewDate: rescheduleDate || t.firstReviewDate,
      mentorFeedback: {
        action: actionType,
        comment: mentorComment || 'Reviewed and updated by mentor.',
        reviewedAt: new Date().toISOString().replace('T', ' ').substring(0, 16)
      }
    } : t));

    // Send Feedback Email Notification
    setEmails(prev => [{
      id: `EML-${Date.now()}`,
      taskId: activeTask.id,
      recipientEmail: 'alexjohnson1@interns.techcorp.io',
      recipientName: activeTask.internName,
      type: `Mentor Review Decision: ${actionType}`,
      subject: `Review Update for "${activeTask.title}"`,
      scheduledTime: new Date().toISOString().replace('T', ' ').substring(0, 16),
      sentAt: new Date().toISOString().replace('T', ' ').substring(0, 16),
      status: 'Sent',
      retryCount: 0,
      body: `Hi ${activeTask.internName},\n\nYour mentor Sarah Connor has completed your task review.\nDecision: ${actionType}\nComments: ${mentorComment || 'None'}`
    }, ...prev]);

    addToast('Review Recorded', toastMessage, 'success');
  };

  return (
    <div className="space-y-6">
      {/* Top Selector Bar */}
