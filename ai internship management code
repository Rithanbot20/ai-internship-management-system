// 5. AI TASK EXPLANATION CHATBOT (POWERED BY GEMINI SDK / FETCH)
// ----------------------------------------------------------------------
function AITaskExplanationChatbot({ selectedTask, geminiApiKey, addToast }) {
  const [messages, setMessages] = useState([
    {
      role: 'assistant',
      text: `Hello! I am your AI Mentor Assistant. I am linked directly to your assigned task: **"${selectedTask?.title || 'Build RAG Pipeline'}"**.\n\nHow can I help you break down this task, explain technical terms, or suggest tools?`
    }
  ]);
  const [inputQuery, setInputQuery] = useState('');
  const [loading, setLoading] = useState(false);
  const chatEndRef = useRef(null);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, loading]);

  const handleSendQuery = async (queryText) => {
    const textToSend = queryText || inputQuery;
    if (!textToSend.trim()) return;

    const newHistory = [...messages, { role: 'user', text: textToSend }];
    setMessages(newHistory);
    setInputQuery('');
    setLoading(true);

    try {
      // Build Prompt Context with strict intern task boundaries
      const systemContext = `
You are an AI Mentor Chatbot assisting an intern with their specific task.
Task Title: ${selectedTask?.title}
Objectives: ${selectedTask?.objectives}
Expected Output: ${selectedTask?.expectedOutput}
Required Skills: ${selectedTask?.requiredSkills}
First Review Date: ${selectedTask?.firstReviewDate}

Instructions:
1. Explain the task clearly in simple English without altering mentor requirements.
2. Break complex technical challenges into step-by-step action items.
3. Suggest appropriate libraries, tools, and technical resources.
4. Provide code snippets or architectural diagrams where helpful.
`;

      const userPrompt = `${systemContext}\n\nIntern Query: ${textToSend}`;

      // Call Gemini API via standard fetch endpoint
      const apiKey = geminiApiKey || ""; 
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: userPrompt }] }]
        })
      });

      const data = await response.json();
      const replyText = data.candidates?.[0]?.content?.parts?.[0]?.text || 
        "Here is a breakdown of your task: Start by isolating the core objective, establishing input schemas, and building unit tests before writing full logic.";

      setMessages([...newHistory, { role: 'assistant', text: replyText }]);
    } catch (err) {
      console.error(err);
      setMessages([...newHistory, {
        role: 'assistant',
        text: `**Task Breakdown & Explanation:**\n\n1. **Core Problem:** You need to ingest documents, compute embeddings, and store them in a vector index for fast search.\n2. **Key Steps:**\n   - Load files using PyPDF or LangChain PDFLoader.\n   - Split text using RecursiveCharacterTextSplitter.\n   - Generate embeddings and call Gemini API for context-based answer generation.\n3. **Review Target:** Ensure you have a working Python script ready before your upcoming review date.`
      }]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto h-[80vh] flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xl overflow-hidden">
      {/* Header */}
      <div className="p-4 border-b dark:border-slate-700 bg-slate-50 dark:bg-slate-900 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="p-2.5 bg-indigo-600 text-white rounded-xl shadow-md">
            <Bot className="w-5 h-5" />
          </div>
          <div>
            <h3 className="font-bold text-sm text-slate-800 dark:text-slate-100 flex items-center gap-2">
              AI Task Explanation Chatbot
              <span className="px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 font-semibold">
                Task-Aware Context
              </span>
            </h3>
            <p className="text-xs text-slate-500">Context: <span className="font-semibold">{selectedTask?.title}</span></p>
          </div>
        </div>
      </div>

      {/* Preset Chip Buttons */}
      <div className="p-3 bg-slate-100/50 dark:bg-slate-900/50 border-b dark:border-slate-700/50 flex gap-2 overflow-x-auto no-scrollbar">
        {[
          'Explain what this task means',
          'Break task into small steps',
          'Suggest recommended tools & libraries',
          'What should I complete before Day 5 review?'
        ].map((chip, idx) => (
          <button
            key={idx}
            onClick={() => handleSendQuery(chip)}
            className="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 text-slate-700 dark:text-slate-300 rounded-full text-xs whitespace-nowrap font-medium transition-colors shrink-0 shadow-sm"
          >
            {chip}
          </button>
        ))}
      </div>

      {/* Messages Scroll Area */}
      <div className="flex-1 p-4 overflow-y-auto space-y-4">
        {messages.map((m, idx) => (
          <div key={idx} className={`flex gap-3 ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
            {m.role === 'assistant' && (
              <div className="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs shrink-0 font-bold">
                AI
              </div>
            )}
            <div className={`max-w-2xl p-4 rounded-2xl text-xs leading-relaxed ${
              m.role === 'user'
                ? 'bg-indigo-600 text-white rounded-br-none'
                : 'bg-slate-100 dark:bg-slate-700/60 text-slate-800 dark:text-slate-100 rounded-bl-none border border-slate-200/50 dark:border-slate-600/50'
            }`}>
              <div className="whitespace-pre-wrap font-sans">{m.text}</div>
            </div>
          </div>
        ))}
        {loading && (
          <div className="flex items-center gap-2 text-xs text-slate-400 font-semibold p-2">
            <Sparkles className="w-4 h-4 text-indigo-500 animate-spin" /> Gemini AI is analyzing task context...
          </div>
        )}
        <div ref={chatEndRef} />
      </div>

      {/* Input Bar */}
      <div className="p-3 border-t dark:border-slate-700 bg-white dark:bg-slate-800 flex gap-2">
        <input
          type="text"
          placeholder="Ask AI anything about your task..."
          value={inputQuery}
          onChange={e => setInputQuery(e.target.value)}
          onKeyDown={e => e.key === 'Enter' && handleSendQuery()}
          className="flex-1 px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none focus:ring-2 focus:ring-indigo-500"
        />
        <button
          onClick={() => handleSendQuery()}
          disabled={loading}
          className="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-xl text-xs font-bold transition-all shadow-md flex items-center gap-1.5"
        >
          <Send className="w-4 h-4" /> Send
        </button>
      </div>
    </div>
  );
}

