          <p className="text-slate-500">SMTP Server: <strong>smtp.sendgrid.net (Port 587)</strong></p>
          <p className="text-slate-500">Notification Engine: <strong>Celery Background Queue Active</strong></p>
        </div>
      </div>
    </div>
  );
